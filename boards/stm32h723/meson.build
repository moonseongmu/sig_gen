c_args += [
    '-mcpu=cortex-m7',
    '-mfpu=fpv5-d16',
    '-mfloat-abi=hard',
    '--target=arm-none-eabi',
]

linkerscript = '-T' + meson.current_source_dir() + '/STM32H723xG_flash.ld'

c_link_args += [
    '-mcpu=cortex-m7',
    '-mfpu=fpv5-d16',
    '-mfloat-abi=hard',
    '--target=arm-none-eabi',
    linkerscript,
    '-Wl,--gc-sections',
    '-Wl,--print-memory-usage',
]

src += files('Src/interface_implementation.c')

src += files('Src/usb_descriptors.c')

src += files(
    'Src/startup_stm32h723xx.c',
    'Src/stm32h7xx_hal_timebase_tim.c',
    'Src/stm32h7xx_it.c',
    'Src/syscalls.c',
    'Src/sysmem.c',
    'Src/system_stm32h7xx.c',
)

