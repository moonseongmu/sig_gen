st_inc = include_directories(
    'Src',
    'Drivers/CMSIS/Device/ST/STM32H7xx/Include',
    'Drivers/STM32H7xx_HAL_Driver/Inc',
)

inc += [st_inc]

add_project_arguments(
    '-DUSE_FULL_LL_DRIVER',
    '-DHSE_VALUE=25000000',
    '-DHSE_STARTUP_TIMEOUT=100',
    '-DLSE_STARTUP_TIMEOUT=5000',
    '-DLSE_VALUE=32768',
    '-DEXTERNAL_CLOCK_VALUE=12288000',
    '-DHSI_VALUE=64000000',
    '-DLSI_VALUE=32000',
    '-DVDD_VALUE=3300',
    '-DUSE_PWR_LDO_SUPPLY',
    '-DSTM32H723xx',
    '-DUSE_HAL_DRIVER',
    language: 'c',
)